{
  "name": "mon-crochet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mon Crochet — bibliothèque de patrons au crochet, compteur de rangs, aperçu 2D et 3D. Hors ligne, sans compte.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "predev": "node scripts/copy-tesseract.mjs",
    "prebuild": "node scripts/copy-tesseract.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
